---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
---

<BaseLayout>
  <Header />
  <main>
    <Hero />
    <section id="servicios" class="section-placeholder" aria-label="Servicios"></section>
    <section id="experiencia" class="section-placeholder" aria-label="Experiencia"></section>
    <section id="portafolio" class="section-placeholder" aria-label="Portafolio"></section>
    <section id="contacto" class="section-placeholder" aria-label="Contacto"></section>
  </main>
</BaseLayout>
