---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Naivi Estudio | Tintes y colorimetría en Coatzacoalcos',
  description = 'Tintes, mechas, cortes de cabello, bótox capilar y keratina por cita previa en Coatzacoalcos, Veracruz.',
} = Astro.props;

const isPreviewOnly = import.meta.env.PUBLIC_PREVIEW_ONLY === 'true';
const hasTurnstileSiteKey = Boolean(import.meta.env.PUBLIC_TURNSTILE_SITE_KEY?.trim());
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fff8f1" />
    <title>{title}</title>
    {!isPreviewOnly && hasTurnstileSiteKey && (
      <script
        data-turnstile-script
        src="https://challenges.cloudflare.com/turnstile/v0/api.js"
        async
        defer
        is:inline
      ></script>
    )}
  </head>
  <body>
    <slot />
    <script>
      import { initGallery } from '../scripts/gallery';
      import { initContact } from '../scripts/contact';
      import { initNavigation } from '../scripts/navigation';
      import { initReveal } from '../scripts/reveal';

      initNavigation();
      initReveal();
      initGallery();
      initContact();
    </script>
  </body>
</html>
