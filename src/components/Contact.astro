---
import { siteContent } from '../content/site';
import { CONTACT_PATH, TURNSTILE_ACTION } from '../shared/contact';
---

<section id="contacto" class="contact content-section" aria-labelledby="contact-title">
  <div class="section-shell contact__inner">
    <div class="contact__copy" data-reveal>
      <p class="eyebrow eyebrow--light">Cita previa</p>
      <h2 id="contact-title">Hablemos de tu próximo cambio</h2>
      <p>
        Cuéntame qué servicio te interesa para revisar tu caso y compartirte una cotización por
        WhatsApp.
      </p>
      <button class="button button--light" type="button" data-contact-open>Solicitar cotización</button>
    </div>
    <div class="contact__details" data-reveal>
      <div>
        <span class="contact__label">Dónde</span>
        <p>{siteContent.location}</p>
        <small>Atención en casa, con ubicación exacta compartida al confirmar.</small>
      </div>
      <div>
        <span class="contact__label">Cuándo</span>
        <p>{siteContent.schedule[0]}<br />{siteContent.schedule[1]}<br />{siteContent.schedule[2]}</p>
        <small>{siteContent.schedule[3]} · Todo</small>
        <span class="contact__appointment">Por cita previa</span>
      </div>
    </div>
  </div>
</section>

<dialog class="contact-dialog" data-contact-dialog aria-labelledby="contact-dialog-title">
  <div class="contact-dialog__inner">
    <div class="contact-dialog__toolbar">
      <div>
        <p class="eyebrow">Cita previa</p>
        <h2 id="contact-dialog-title">Cuéntame qué tienes en mente</h2>
      </div>
      <button class="contact-dialog__close" type="button" data-contact-close aria-label="Cerrar contacto">×</button>
    </div>
    <p class="contact-dialog__intro">
      Verificaremos que eres una persona antes de abrir la conversación segura de WhatsApp.
    </p>
    <form action={CONTACT_PATH} method="post" data-contact-form>
      <div class="cf-turnstile" data-sitekey={import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? ''} data-action={TURNSTILE_ACTION}></div>
      <button class="button button--primary" type="submit" data-contact-submit>Continuar a WhatsApp</button>
      <p class="contact-dialog__status" data-contact-status aria-live="polite"></p>
    </form>
    <noscript>
      <p class="contact-dialog__noscript">Activa JavaScript para completar la verificación de seguridad.</p>
    </noscript>
  </div>
</dialog>
