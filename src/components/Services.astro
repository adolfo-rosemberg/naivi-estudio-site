---
import { siteContent } from '../content/site';

const serviceDetails = [
  'Color diseñado para acompañar tu tono de piel y tu estilo.',
  'Dimensiones de luz para darle movimiento a tu cabello.',
  'Cortes que enmarcan tu rostro y se sienten tuyos.',
  'Suavidad, brillo y cuidado para una melena más manejable.',
  'Tratamiento de alisado con atención personalizada.',
] as const;

const serviceAccents = ['fuchsia', 'teal', 'copper', 'plum', 'rose'] as const;
const serviceIconNames = ['tintes', 'mechas', 'cortes', 'botox', 'keratina'] as const;
---

<section id="servicios" class="content-section section-shell services services--integrated" aria-labelledby="services-title">
  <div class="section-heading" data-reveal>
    <p class="eyebrow">Servicios</p>
    <h2 id="services-title">Servicios para tu próximo cambio</h2>
    <p>Cuéntame qué tienes en mente y juntas encontramos la mejor ruta para tu cabello.</p>
  </div>
  <div class="services__grid">
    {siteContent.services.map((service, index) => (
      <article class:list={["service-card", `service-card--${serviceAccents[index]}`]} data-reveal>
        <div class="service-card__top">
          <span class="service-card__number" aria-hidden="true">0{index + 1}</span>
          <span class="service-card__icon" data-service-icon={serviceIconNames[index]} aria-hidden="true">
            <svg viewBox="0 0 24 24" role="presentation" focusable="false">
              {index === 0 && (
                <>
                  <path d="M4 14h16" />
                  <path d="M6 14v2.5a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V14" />
                  <path d="m14 4 5 5" />
                  <path d="m12.5 5.5 2 2" />
                  <path d="m13 5 2-2 3 3-2 2" />
                </>
              )}
              {index === 1 && (
                <>
                  <path d="M6 18v-4a6 6 0 0 1 12 0v4" />
                  <path d="M8.5 12.5v5.5M12 11.5V18M15.5 12.5v5.5" />
                  <path d="M6 12a6 6 0 0 1 12 0" />
                  <path d="M4 5v4M2 7h4" />
                  <path d="M19 4v3M17.5 5.5h3" />
                </>
              )}
              {index === 2 && (
                <>
                  <circle cx="6.5" cy="7" r="2.5" />
                  <circle cx="6.5" cy="17" r="2.5" />
                  <path d="m8.5 8.5 10 10M8.5 15.5 19 5" />
                </>
              )}
              {index === 3 && (
                <>
                  <path d="M6 11h8v8H6z" />
                  <path d="M8 11V7h4v4M7 7h6M8 14h4" />
                  <path d="M14 12h3l1.5 1.5" />
                  <path class="service-icon__drop" d="M18.5 15c1.2 1.4 1.8 2.3 1.8 3.1a1.8 1.8 0 0 1-3.6 0c0-.8.6-1.7 1.8-3.1Z" />
                </>
              )}
              {index === 4 && (
                <>
                  <path d="M6 7c1.8-2.5 4-3.5 6-3.5S16.2 4.5 18 7" />
                  <path d="M7 7v9a5 5 0 0 0 10 0V7" />
                  <path d="M10 8v8M14 8v8" />
                  <path d="M20 4v4M18 6h4" />
                </>
              )}
            </svg>
          </span>
        </div>
        <h3>{service}</h3>
        <p>{serviceDetails[index]}</p>
      </article>
    ))}
  </div>
</section>
