---
import { Image } from 'astro:assets';
import { galleryItems } from '../content/site';
---

<section id="portafolio" class="content-section section-shell gallery" aria-labelledby="gallery-title">
  <div class="section-heading section-heading--split" data-reveal>
    <div>
      <p class="eyebrow">Portafolio</p>
      <h2 id="gallery-title">Una mirada a mis trabajos</h2>
    </div>
    <p>Ideas reales para inspirarte. Cada resultado se adapta a tu cabello y a tu rutina.</p>
  </div>
  <div class="gallery__grid" data-gallery-grid>
    {galleryItems.map((item, index) => (
      <button
        class:list={['gallery-card', index === 0 && 'gallery-card--feature']}
        type="button"
        data-gallery-trigger
        data-gallery-index={index}
        aria-label={`Ampliar trabajo ${index + 1}`}
      >
        <Image src={item.image} alt={item.alt} width={720} height={720} loading={index < 3 ? 'eager' : 'lazy'} />
        <span class="gallery-card__veil" aria-hidden="true"><span>Ver trabajo</span></span>
      </button>
    ))}
  </div>
  <dialog class="gallery-dialog" data-gallery-dialog aria-labelledby="gallery-dialog-title">
    <div class="gallery-dialog__inner">
      <div class="gallery-dialog__toolbar">
        <p id="gallery-dialog-title">Trabajo de Naivi Estudio</p>
        <button class="gallery-dialog__close" type="button" data-gallery-close aria-label="Cerrar imagen">×</button>
      </div>
      <div class="gallery-dialog__stage">
        <button class="gallery-dialog__arrow" type="button" data-gallery-prev aria-label="Trabajo anterior">‹</button>
        <img data-gallery-dialog-image src="" alt="" width="900" height="900" />
        <button class="gallery-dialog__arrow" type="button" data-gallery-next aria-label="Trabajo siguiente">›</button>
      </div>
      <p class="gallery-dialog__caption" data-gallery-caption></p>
    </div>
  </dialog>
</section>
