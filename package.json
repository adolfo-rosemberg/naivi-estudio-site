{
  "name": "naivi-estudio-site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "serve:dist": "node scripts/serve-dist.mjs",
    "check": "astro check",
    "test": "npm run test:unit && npm run test:worker && npm run test:e2e && npm run test:integration",
    "test:unit": "vitest run tests/unit",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:e2e": "npm run build && node scripts/run-e2e.mjs",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "astro": "^7.3.1"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vitest-plugin": "^1.1.4",
    "@cloudflare/workers-types": "^5.20260903.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^4.1.11",
    "playwright": "^1.62.1",
    "vitest": "^4.1.11",
    "wrangler": "^4.129.0"
  }
}
